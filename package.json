{
  "name": "mdls",
  "version": "2.0.0",
  "description": "OSX's mdls from node.",
  "main": "index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./index.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "prepublishOnly": "npm run build",
    "tsc": "tsc",
    "build": "rollup -c && npm run tsc",
    "lint": "eslint .",
    "test": "node test.js"
  },
  "keywords": [
    "mdls",
    "osx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brettz9/node-mdls.git"
  },
  "author": "Andrew Winterman",
  "contributors": [
    "Brett Zamir"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brettz9/node-mdls/issues"
  },
  "homepage": "https://github.com/brettz9/node-mdls#readme",
  "engines": {
    "node": ">= 6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3"
  }
}
